{
    "version": "2.0.0",
    "tasks": [
{
"label": "Build",
"type": "shell",
"command": "mpic++",
"args": [
"-o",
"cpi", // тут за потреби змінити назву
"cpi.c" // тут за потреби змінити назву
],
"group": {
"kind": "build",
"isDefault": true
},
"problemMatcher": "$gcc"
},
{
"label": "Run",
"type": "shell",
"command": "mpirun",
"args": [
"-np",
"4", // тут за потреби змінити к-сть процесів
"./cpi" // тут за потреби змінити назву
],
"dependsOn": "Build"
}
]
}